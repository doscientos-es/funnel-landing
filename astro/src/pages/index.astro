  <!-- Doble envío del lead: GHL ya lo recibe desde el propio iframe. Cuando el formulario
       se envía bien, GHL avisa a esta página con un postMessage
       ["set-sticky-contacts", "_ud", "<JSON del contacto>"]. Lo escuchamos y reenviamos el
       mismo lead al backoffice (/api/public/leads), igual que el formulario de la landing.
       Si GHL cambiara ese formato, el lead seguiría llegando a GHL pero no al backoffice. -->
  <script>
    (function () {
      var LEADS_ENDPOINT = "https://app.doscientos.es/api/public/leads";
      var FORM_NAME = "GOOGLE ADS";
      var sent = {};

      function isOurIframe(source) {
        var frames = document.querySelectorAll('iframe[data-form-id="WCEM83cs117HgWgAWREj"]');
        for (var i = 0; i < frames.length; i++) {
          if (frames[i].contentWindow === source) return true;
        }
        return false;
      }

      function param(name) {
        try { return new URLSearchParams(window.location.search).get(name) || undefined; }
        catch (e) { return undefined; }
      }

      function buildLead(c) {
        var name = (c.full_name || c.name ||
          [c.first_name, c.last_name].filter(Boolean).join(" ")).trim();
        var lead = {
          name: name || "Lead Google Ads",
          email: c.email || undefined,
          phone: c.phone || undefined,
          company: c.company_name || c.companyName || undefined,
          message: "Lead desde el formulario \"" + FORM_NAME + "\" (landing de Google Ads, GHL)",
          language: "es",
          landing_path: window.location.pathname,
          landing_ref: "google-ads",
          landing_subject: document.title,
          referrer: document.referrer || undefined,
          gclid: param("gclid"),
          utm_source: param("utm_source") || (param("gclid") ? "google" : undefined),
          utm_medium: param("utm_medium") || (param("gclid") ? "cpc" : undefined),
          utm_campaign: param("utm_campaign"),
          utm_term: param("utm_term"),
          utm_content: param("utm_content"),
          dedupeKey: c.id ? "ghl-" + c.id : undefined,
          website: ""
        };
        Object.keys(lead).forEach(function (k) { if (lead[k] === undefined) delete lead[k]; });
        return lead;
      }

      window.addEventListener("message", function (event) {
        var data = event.data;
        if (!Array.isArray(data) || data[0] !== "set-sticky-contacts" || data[1] !== "_ud") return;
        if (!isOurIframe(event.source)) return;

        var contact;
        try { contact = JSON.parse(data[2]); } catch (e) { return; }
        if (!contact || (!contact.email && !contact.phone)) return;

        var key = contact.id || contact.email || contact.phone;
        if (sent[key]) return;
        sent[key] = true;

        fetch(LEADS_ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(buildLead(contact)),
          keepalive: true
        }).catch(function () { sent[key] = false; });
      });
    })();
  </script>
</body>

</html>