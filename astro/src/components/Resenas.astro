---
const {comentario, nombre, imagen} = Astro.props
---

<div class="w-[480px] h-[250px] bg-[#15170f] rounded-xl flex flex-col gap-7 justify-between box-border p-10 border border-white/10 shadow transition-colors duration-200 hover:border-lime-300 bg-red text-white text-center">
    <p class="h-2/3 w-90 m-auto content-center">"{comentario}"</p>
    <div class="flex gap-3 items-center justify-center h-1/3">
        <div class="overflow-hidden size-6 rounded-full">
            <img src={imagen} alt="Foto del usuario" class="bg-white size-full object-cover">
        </div>
        <span>/</span>
        <p class="text-sm">{nombre}</p>
        <span>/</span>
        <div class="text-lime-400">★★★★★</div>
    </div>
</div>