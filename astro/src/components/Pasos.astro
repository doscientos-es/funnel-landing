---
const {numero, titulo, texto, color = "bg-white", borde = ""} = Astro.props;
---

<li class={`flex flex-row items-center content-center gap-4 w-full text-left box-border px-10 sm:pl-0 sm:flex-col sm:items-center sm:text-center sm:max-w-60 border-lime-400 ${borde} sm:px-0`}>
    <p class={`size-11 shrink-0 text-2xl text-black font-bold ${color} flex justify-center items-center rounded-full`}>{numero}</p>
    <div class="flex flex-col gap-1">
        <h3 class="text-lg font-bold text-white">{titulo}</h3>
        <p class="text-sm text-white">{texto}</p>
    </div>
</li>