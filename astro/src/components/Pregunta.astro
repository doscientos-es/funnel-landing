---
const {pregunta, respuesta} = Astro.props 
---

<details class="w-[700px] text-white bg-[#15170f] content-center box-border px-5 py-5 border-1 border-[#15170f] rounded-md cursor-pointer hover:border-lime duration-200 group">
    <summary class="flex justify-between items-center font-bold"><p>{pregunta}</p><i class="fa-solid fa-plus text-sm group-hover:text-lime duration-200 group-open:rotate-45"></i></summary>
    <div class="mt-6 text-sm">{respuesta}</div>
</details>